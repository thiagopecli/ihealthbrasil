# Ambiente: development | production
DJANGO_ENV=development

# Debug deve ser False em producao
DEBUG=True

# Defina uma chave forte em producao
SECRET_KEY=change-this-secret-key

# Hosts permitidos separados por virgula
ALLOWED_HOSTS=127.0.0.1,localhost

# Em desenvolvimento, deixe vazio para usar SQLite automaticamente
# Em producao, usar algo como:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Apenas para SQLite local
SQLITE_NAME=db.sqlite3

# Opcional: conexao persistente do Django
DB_CONN_MAX_AGE=60

# Recomenda-se True em producao com PostgreSQL gerenciado
DB_SSL_REQUIRE=True

# JWT (opcional)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
