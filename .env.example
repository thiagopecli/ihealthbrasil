# Ambiente: development | production
DJANGO_ENV=development

# Debug deve ser False em producao
DEBUG=True

# Defina uma chave forte em producao
SECRET_KEY=change-this-secret-key

# Hosts permitidos separados por virgula
ALLOWED_HOSTS=127.0.0.1,localhost

# Em producao, informe origens confiaveis para CSRF (comma-separated)
# Exemplo: https://api.ihealthbrasil.com,https://admin.ihealthbrasil.com
CSRF_TRUSTED_ORIGINS=

# Em desenvolvimento, deixe vazio para usar SQLite automaticamente
# Em producao, usar algo como:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Apenas para SQLite local
SQLITE_NAME=db.sqlite3

# Opcional: conexao persistente do Django
DB_CONN_MAX_AGE=60

# Recomenda-se True em producao com PostgreSQL gerenciado
DB_SSL_REQUIRE=True

# Storage em nuvem para uploads e midia publica
# providers: local | s3
MEDIA_STORAGE_PROVIDER=local
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=
AWS_PUBLIC_MEDIA_LOCATION=media
AWS_PRIVATE_MEDIA_LOCATION=private
PRESCRIPTION_SIGNED_URL_TTL_SECONDS=300

# Seguranca HTTP (producao)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# JWT (opcional)
# Chave de assinatura dos tokens JWT (se vazio, usa SECRET_KEY)
# Em producao, use no minimo 32 caracteres aleatorios.
JWT_SIGNING_KEY=H4VYXkfu1efdcNGUrVxTo9Y9ZQykI72FlwP0ucIXIRbyTFj6P2QASvSg5LDRk2A_LvlrrwyvTxBeXA6Qi_VqRQ

# Google OAuth (para validação no backend)
# Opcional: o Client ID é principalmente para uso no frontend
# O backend valida usando google-auth library
# Se implementar validação adicional, adicione aqui
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Pagamentos (Sprint 6)
# providers: mock | stripe
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_DEFAULT_CURRENCY=brl
PAYMENT_SUCCESS_URL=http://127.0.0.1:8000/payment/success
PAYMENT_CANCEL_URL=http://127.0.0.1:8000/payment/cancel
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Integracoes externas (Sprint 8)
SMS_ENABLED=True
# providers: mock | twilio
SMS_PROVIDER=mock

# Twilio (obrigatorio somente quando SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Memed Integration - Prescricoes Externas (Sprint 8)
MEMED_ENABLED=False
# providers: mock | memed
MEMED_PROVIDER=mock
MEMED_API_KEY=
MEMED_API_BASE_URL=https://api.memed.com.br/v1

# Email Notifications (Sprint 8)
EMAIL_ENABLED=False
# backends: django.core.mail.backends.smtp.EmailBackend | django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_FROM_ADDRESS=noreply@ihealthbrasil.com.br

# Celery + Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True
CELERY_TASK_IGNORE_RESULT=True
